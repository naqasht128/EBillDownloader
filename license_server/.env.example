# E-Bill Downloader License Server Environment Variables
PORT=3000

# Supabase Credentials (from your existing Supabase project)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Secret for Admin endpoints (generate serial keys, set update links)
ADMIN_SECRET=EBillDownloader_Secret_Key_2026

# GitHub Repository Configuration for Update Proxy
GITHUB_REPO=your-github-username/EBillDownloader
GITHUB_TOKEN=ghp_your_fine_grained_github_pat_here

# Multi-Tenancy Supabase Table Names (allows running in same Supabase project as BillScrapper)
TABLE_LICENSES=ebill_licenses
TABLE_DEVICES=ebill_license_devices
TABLE_UPDATES=ebill_app_updates
KEY_PREFIX=EB
